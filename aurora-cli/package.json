{
  "name": "@kin666/aurora-cli",
  "version": "0.1.0",
  "description": "Command-line toolkit for creating, extending, and validating Aurora projects.",
  "type": "module",
  "bin": {
    "aurora": "dist/index.js"
  },
  "files": [
    "dist",
    "packages",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean.mjs && tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "release:check": "npm test && node scripts/release-check.mjs"
  },
  "keywords": [
    "aurora",
    "cli",
    "project-generator",
    "nextjs",
    "typescript",
    "developer-tools"
  ],
  "author": "kin666",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.6",
    "next-auth": "^5.0.0-beta.30",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
